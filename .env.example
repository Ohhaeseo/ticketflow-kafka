# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 커밋하지 않습니다.
#   Copy-Item .env.example .env
# docker compose와 Spring Boot(backend/application.yml)가 모두 이 값을 읽습니다.
# 모든 포트는 127.0.0.1에만 바인딩합니다 (PRD NFR-SEC-01).

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=change-me-local-only

# --- Kafka (KRaft single-node, 호스트 포트 9092 고정) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Consumer 정적 멤버십 id. 애플리케이션을 여러 개 띄울 때만 인스턴스마다 다르게 준다 (기본 ticketflow-local-1)
# KAFKA_GROUP_INSTANCE_ID=ticketflow-local-1

# --- Redis (요청 빈도 제한) ---
REDIS_HOST=localhost
REDIS_PORT=16379

# --- Monitoring (--profile monitoring) ---
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# --- Application ---
SERVER_PORT=8080
